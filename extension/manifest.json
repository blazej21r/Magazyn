{
  "manifest_version": 3,
  "name": "MyMagazine dla Vinted",
  "short_name": "MyMagazine",
  "version": "1.0.0",
  "description": "Łączy Vinted z aplikacją MyMagazine: ogłoszenia i zamówienia do magazynu, szablony wiadomości, odświeżanie ogłoszeń i statystyki.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "MyMagazine",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*.vinted.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.vinted.pl/*",
        "https://www.vinted.com/*",
        "https://www.vinted.co.uk/*",
        "https://www.vinted.de/*",
        "https://www.vinted.fr/*",
        "https://www.vinted.cz/*",
        "https://www.vinted.sk/*",
        "https://www.vinted.lt/*",
        "https://www.vinted.it/*",
        "https://www.vinted.es/*",
        "https://www.vinted.nl/*",
        "https://www.vinted.be/*",
        "https://www.vinted.at/*"
      ],
      "js": [
        "shared.js",
        "vinted.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://blazej21r.github.io/Magazyn/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-48.png"
      ],
      "matches": [
        "https://www.vinted.pl/*",
        "https://www.vinted.com/*",
        "https://www.vinted.co.uk/*",
        "https://www.vinted.de/*",
        "https://www.vinted.fr/*",
        "https://www.vinted.cz/*",
        "https://www.vinted.sk/*",
        "https://www.vinted.lt/*",
        "https://www.vinted.it/*",
        "https://www.vinted.es/*",
        "https://www.vinted.nl/*",
        "https://www.vinted.be/*",
        "https://www.vinted.at/*"
      ]
    }
  ]
}
